GEMINI_API_KEY=
# Optional: Gemini model used by the bounded case-workflow planner.
GEMINI_MODEL=gemini-3.8-flash
# Optional: set a stable random value for Flask's signed demo-session cookie.
# Generate a private value locally; do not commit real credentials.
CAMUS_SECRET_KEY=replace-with-a-random-secret
# Get key from https://aistudio.google.com/app/apikey
# Never commit .env. Do not send real student data to external services.
